{
  "name": "pr-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app.js",
    "test": "node --test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci --error-on-warnings . && cricket check api/index.js",
    "inspect": "cricket inspect api/index.js"
  },
  "bin": {
    "pr-chat": "./cli.js"
  },
  "dependencies": {
    "@robdel12/cricket": "https://codeload.github.com/Robdel12/cricket/tar.gz/357d5924fc5fc9c7d68fbe375539e50d8d9af027"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "ws": "8.22.1"
  }
}

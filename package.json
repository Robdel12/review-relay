{
  "name": "pr-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app.js",
    "test": "cricket test --reporter spec",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci --error-on-warnings . && cricket check api/index.js",
    "inspect": "cricket inspect api/index.js"
  },
  "bin": {
    "pr-chat": "./cli.js"
  },
  "dependencies": {
    "@robdel12/cricket": "https://codeload.github.com/Robdel12/cricket/tar.gz/77157359e062b29ffc3d04669c5a8c12d603f421",
    "better-sqlite3": "13.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "ws": "8.22.1"
  }
}

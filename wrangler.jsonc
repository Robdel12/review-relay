{
  "name": "pr-chat-relay",
  "main": "relay.js",
  "compatibility_date": "2026-11-23",
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "GITHUB_REPOSITORY": "owner/repo" },
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "Inbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }]
}
